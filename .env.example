# Copia este archivo como .env.local y rellena los valores
# (en Vercel van en Project Settings > Environment Variables)

# Cadena de conexión a Neon (pooler, para la app)
DATABASE_URL=

# Cadena directa (sin pooler, para migraciones)
DATABASE_URL_UNPOOLED=

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión (texto aleatorio largo)
SESSION_SECRET=
